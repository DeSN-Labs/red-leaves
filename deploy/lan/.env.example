# Copy to an ignored .env.profile. Requires a NAS binary installed at LAN_REMOTE_ROOT/bin/red-leaves.
# Authenticate SSH masters before testing; do not store SSH passwords in this file.
LAN_HOSTS=192.168.0.212,192.168.0.213,192.168.0.214
LAN_SSH_USER=loop
LAN_SSH_CONTROL_DIR=/tmp
LAN_REMOTE_ROOT=/home/loop/red-leaves-lan-test
# Loopback reverse forwarding on each server. Must be unused.
LAN_RPC_PORT=18545
# relay or direct; both use SSH tunnels for API and RPC.
LAN_TRANSPORT=relay
