# Copy the repository root .env.example to .env.profile and start the node from the repository root.
# Copy to .env.profile in the repository root. Do not commit local credentials.
RED_LEAVES_LISTEN=127.0.0.1:3000
RED_LEAVES_DATABASE_URL=sqlite://red-leaves.sqlite
RED_LEAVES_AUTH_URI=http://127.0.0.1:5173
# Preserve this key when moving or backing up the NAS. Never replace it on normal restart.
RED_LEAVES_NODE_KEY_PATH=runtime/nas/node.key
