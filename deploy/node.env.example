# Copy the repository root .env.example to .env.profile and start the node from the repository root.
# Copy to .env.profile in the repository root. Do not commit local credentials.
RED_LEAVES_LISTEN=127.0.0.1:3000
RED_LEAVES_DATABASE_URL=sqlite://red-leaves.sqlite
# Trusted Web origin for SIWE and credentialed CORS; use HTTPS and same-site API in production.
RED_LEAVES_AUTH_URI=http://127.0.0.1:5173
# Preserve this key when moving or backing up the NAS. Never replace it on normal restart.
RED_LEAVES_NODE_KEY_PATH=runtime/nas/node.key
# Fresh on-chain registry reads. Only Base Sepolia (84532) is supported.
RED_LEAVES_RPC_URL=https://sepolia.base.org
RED_LEAVES_USER_REGISTRY_ADDRESS=
# Ciphertext/public post objects are stored in the filesystem; SQLite stores metadata.
RED_LEAVES_CONTENT_PATH=runtime/nas/content
# Preserve BOTH the master key and encrypted per-user key files when backing up.
RED_LEAVES_MASTER_KEY_PATH=runtime/nas/master.key
RED_LEAVES_USER_KEY_PATH=runtime/nas/user-keys

# PeerIds alone do not contain dial addresses. Configure peers or common public relays.
RED_LEAVES_P2P_ENABLED=true
RED_LEAVES_P2P_LISTEN=/ip4/0.0.0.0/tcp/4001
# Publicly reachable address(es), needed for a public relay behind port mapping.
RED_LEAVES_P2P_ADVERTISE=
# Comma-separated multiaddrs ending in /p2p/<PeerId>.
RED_LEAVES_P2P_PEERS=
RED_LEAVES_P2P_RELAYS=
# Public relay mode; relay-only builds always enable the circuit server.
RED_LEAVES_P2P_RELAY_SERVER=false
# Per-circuit cap, 1 MiB to 1 GiB. Relay traffic billing is not implemented.
RED_LEAVES_RELAY_MAX_BYTES=134217728

# Node logging: English messages; credentials and request bodies are never logged.
RED_LEAVES_LOG_LEVEL=info
# text or json, applied to both console and files.
RED_LEAVES_LOG_FORMAT=text
RED_LEAVES_LOG_CONSOLE=true
RED_LEAVES_LOG_FILE=true
# Dedicated private directory (Unix permissions 700); created automatically if missing.
RED_LEAVES_LOG_DIR=runtime/logs
# UTC daily rotation; maximum matching files retained per node role.
RED_LEAVES_LOG_MAX_FILES=7
